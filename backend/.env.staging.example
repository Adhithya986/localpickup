# ========================================================
# LocalPickup SaaS Staging Environment Configuration Template
# NOTE: DO NOT commit actual secrets. Copy this file to .env on staging server.
# ========================================================

# Server Runtime
PORT=5000
NODE_ENV=staging

# Authentication & Security
# Generate a strong 32-byte secret on staging server using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_at_least_32_char_secret_for_staging
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Staging Frontend Domain)
CORS_ORIGIN=https://staging.localpickup.yourdomain.com

# Isolated Staging Document Storage Path (Must be separate from production uploads)
UPLOAD_DIR=/var/lib/localpickup/staging_uploads

# Isolated Staging SQLite Database Path (Must be separate from production DB)
DB_PATH=/var/lib/localpickup/data/localpickup_staging.db
DATABASE_PATH=/var/lib/localpickup/data/localpickup_staging.db

# Optional: Enable demo credentials box for staging testing (disabled in public production)
# VITE_SHOW_DEMO_ACCOUNTS=true

# ========================================================
# LocalPickup SaaS Environment Configuration Template
# NOTE: DO NOT commit actual secrets or production credentials.
# ========================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Authentication & Security
# In production, JWT_SECRET MUST be at least 32 cryptographically random characters
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_at_least_32_char_secret_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Production URL of frontend application)
CORS_ORIGIN=http://localhost:5173

# Document Storage Configuration
# Persistent directory for customer print uploads (absolute or relative to backend)
UPLOAD_DIR=uploads

# Database Configuration (Embedded SQLite with node:sqlite)
# File path to SQLite database. Set to ':memory:' for transient test suites.
DB_PATH=localpickup.db
DATABASE_PATH=localpickup.db

# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
# WARNING: In production, generate a high-entropy string of at least 32 characters
JWT_SECRET=replace_with_a_secure_random_at_least_32_char_secret_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Storage Configuration
UPLOAD_DIR=uploads

# Database Configuration (Embedded SQLite)
# Defaults to 'localpickup.db' relative to backend root; use ':memory:' for tests
DATABASE_PATH=localpickup.db
